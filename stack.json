{
  "name": "orca-ade-stack",
  "version": "1.1.1",
  "based_on": "Hardened headless Orca ADE on Ubuntu + Tailscale (2026 pattern)",
  "min_memory_mb": 8192,
  "recommended_linode_type": "g6-standard-4",
  "os": [
    "ubuntu24.04",
    "ubuntu26.04"
  ],
  "pins": {
    "node": "22.18.0",
    "ruby": "3.3.4",
    "orca_appimage": "https://github.com/stablyai/orca/releases/latest/download/orca-linux.AppImage"
  },
  "secrets_not_included": [
    "TAILSCALE_AUTH_KEY",
    "SSH_PRIVATE_KEYS",
    "GITHUB_TOKEN",
    "GOOGLE_APPLICATION_CREDENTIALS_JSON",
    "gh/claude/cursor OAuth"
  ],
  "post_boot_scripts": [
    "scripts/01-tailscale-and-lockdown.sh",
    "scripts/02-orca-serve.sh",
    "scripts/03-dev-toolchains.sh"
  ],
  "repo": "https://github.com/asakaxgit/orca-ade-stack",
  "cloud_init_clones_repo": true
}
